# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor  
#  Cursor is an AI-powered code editor.`.cursorignore` specifies files/directories to 
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# --- Project-specific runtime outputs -------------------------------------
# Trained model artifacts, the runtime registry, and their metadata are
# regenerated by training runs. Only the directory placeholder (ml/artifacts/
# .gitkeep), the isolated synthetic demo artifacts (demo_synthetic / demo_synthetic_v2),
# and the annotation datasets under data/annotations/ belong in Git.
ml/artifacts/*.joblib
ml/artifacts/*/
!ml/artifacts/demo_synthetic/
!ml/artifacts/demo_synthetic/**
!ml/artifacts/demo_synthetic_v2/
!ml/artifacts/demo_synthetic_v2/**
!ml/artifacts/live_corpus/
!ml/artifacts/live_corpus/**
!ml/artifacts/v6_3_experiments/
!ml/artifacts/v6_3_experiments/**
!ml/artifacts/v6_4_experiments/
!ml/artifacts/v6_4_experiments/**
ml/artifacts/registry.json
ml/artifacts/**/trainer_metadata.json

# Duplicate artifact tree accidentally produced when running from backend/.
backend/ml/

# Model checkpoints / weights produced by the PyTorch transformer path.
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
ml/models/transformer/**/model/
ml/models/transformer/**/checkpoints/

# Local scratch/training data (raw collection output, caches, exports).
data/raw/
data/interim/
data/processed/
data/exports/
data/annotations/*pilot*/

# Local databases and caches.
*.sqlite
*.sqlite3
*.db
*.db-journal

# Ad-hoc editor/backup copies of source files.
*.bak
*.orig
*.rej

# Design / tooling metadata & local scratch subtrees
.hallmark/
.omnirush/
AI Project/
